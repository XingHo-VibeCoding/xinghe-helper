# ============================================================
# Day 20 起前端只调公网接口，不再直连数据库
# ============================================================
# 复制本文件为 .env 后填写。
# 注意：.env 不要提交到 git（已在 .gitignore 里）。

# 公网接口根地址 —— 无末尾斜杠
# 从 docs/api-contract.md 第 0 节拿到的 Base URL
VITE_API_BASE_URL=https://xinghe-helper-d5g92pis442fd9947.service.tcloudbase.com

# 当前营期 id。MVP 恒为 1；将来开第二个营期时改这里，前端不用动代码。
VITE_CAMP_ID=1

# ------------------------------------------------------------
# 下面是 Day 8~19 用的 Supabase 直连配置，Day 20 起已不再需要。
# 保留这段说明是为了留个记录：以前前端是拿 anon key 直连数据库的，
# 现在改成只调自己的云函数接口，anon key 不再进入前端产物。
# 确认新接口跑通后，可以把这段删掉。
# ------------------------------------------------------------
# VITE_SUPABASE_URL=https://你的项目ID.supabase.co
# VITE_SUPABASE_ANON_KEY=你的anon公开密钥

# ------------------------------------------------------------
# 演示模式：把下面这行去掉注释，页面就用本地假数据(mock)，不连接口。
# 用途：接口没部署好、或者要给同伴演示界面时用。
# 注意演示模式下所有「保存」类操作会被明确拒绝，不会假成功。
# ------------------------------------------------------------
# VITE_USE_MOCK=true